---
layout: default
---
{% if site.enable_climate_particles %}
  <div class="particles-container">
    <canvas id="climate-particles-canvas"></canvas>
  </div>
{% endif %}
<div class="post climate-home">
  <article>
    <section class="climate-hero" aria-label="Research overview">
      <div class="climate-hero__copy">
        <p class="climate-hero__eyebrow">AI for climate</p>
        <header class="post-header climate-hero__header">
          <h1 class="post-title">
            {% if site.title == 'blank' %}
              <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
              {{ site.last_name }}
            {% else %}
              {{ site.title }}
            {% endif %}
          </h1>
          <p class="desc">{{ page.subtitle }}</p>
        </header>
        <div class="climate-bio">{{ content }}</div>
      </div>

      {% if page.profile %}
        <aside class="climate-profile-card" aria-label="Research profile">
          <div class="climate-profile-card__orbit"></div>
          {% if page.profile.image %}
            {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
            {% if page.profile.image_circular %}
              {% assign profile_image_class = 'img-fluid rounded-circle climate-profile-card__image' %}
            {% else %}
              {% assign profile_image_class = 'img-fluid rounded climate-profile-card__image' %}
            {% endif %}
            {% capture sizes %}(min-width: {{ site.max_width }}) 280px, (min-width: 576px) 34vw, 84vw{% endcapture %}
            {%
              include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
              cache_bust=true
            %}
          {% endif %}
          {% if page.profile.more_info %}
            <div class="more-info">{{ page.profile.more_info }}</div>
          {% endif %}
          <div class="climate-profile-card__meta">
            <span>remote sensing</span>
            <span>machine learning</span>
            <span>statistical learning</span>
          </div>
          <div class="climate-profile-card__status" aria-hidden="true">
            <span>polar regions</span>
            <span>sea ice</span>
          </div>
        </aside>
      {% endif %}

      <div class="climate-theme-grid" aria-label="Research themes">
        <article class="climate-theme-card">
          <span>01</span>
          <strong>ML for Climate</strong>
          <p>models for noisy geophysical data</p>
        </article>
        <article class="climate-theme-card">
          <span>02</span>
          <strong>Polar Observation</strong>
          <p>sea-ice signals from satellites</p>
        </article>
        <article class="climate-theme-card">
          <span>03</span>
          <strong>Climate Inference</strong>
          <p>downscaling and inverse problems</p>
        </article>
      </div>
    </section>

    <div class="climate-sections">
    <!-- News -->
    {% if page.news and site.announcements and site.announcements.enabled %}
      <section class="climate-section climate-section--updates">
        <div class="climate-section__head">
          <p class="climate-section__label">field log</p>
          <h2>
            <a href="{{ '/news/' | relative_url }}" style="color: inherit">recent updates</a>
          </h2>
        </div>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}

    <!-- Latest posts -->
    {% if site.latest_posts and site.latest_posts.enabled %}
      <section class="climate-section">
        <p class="climate-section__label">latest notes</p>
        <h2>
          <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
        </h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <section class="climate-section climate-section--outputs">
        <div class="climate-section__head">
          <p class="climate-section__label">selected outputs</p>
          <h2>
            <a href="{{ '/publications/' | relative_url }}" style="color: inherit">research work</a>
          </h2>
        </div>
        {% include selected_papers.liquid %}
      </section>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social climate-social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
    </div>
  </article>
</div>
